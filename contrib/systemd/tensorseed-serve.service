#
# tensorseed serve as a hardened systemd service (spec section 8.3).
#
# Install:
#   install -m 0755 tensorseed /usr/local/bin/tensorseed
#   install -d -m 0755 /etc/tensorseed
#   install -m 0644 tensorseed.toml /etc/tensorseed/tensorseed.toml
#   install -m 0644 tensorseed-serve.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now tensorseed-serve
#
# Everything the daemon writes lives in /var/lib/tensorseed (StateDirectory).
# HOME points there, so the default "~/.local/share/tensorseed/..." paths in
# the config resolve inside it. Seeding a published tree elsewhere (for
# example /srv/tensorseed) needs a ReadOnlyPaths= line for it below, or
# ReadWritePaths= if serve may prune or fetch into it.
#
# Health: curl -s http://127.0.0.1:6880/health   (serve.health_listen)

[Unit]
Description=Tensorseed seeder (tensorseed serve)
Documentation=https://tensorseed.dev
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tensorseed --log-format json serve
Environment=TENSORSEED_CONFIG=/etc/tensorseed/tensorseed.toml
Environment=HOME=/var/lib/tensorseed
# Only needed for gated Hub repos; never put the token in the TOML.
# EnvironmentFile=-/etc/tensorseed/env

# Clean shutdown: SIGTERM stops seeding, removes port mappings, and saves
# serve-state.json; a restart resumes seeding before the first catalog sync.
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=30

# A throwaway user per run; files stay owned by it across restarts.
DynamicUser=yes
# Or a dedicated account instead:
# User=tensorseed
# Group=tensorseed
StateDirectory=tensorseed
StateDirectoryMode=0750
ConfigurationDirectory=tensorseed
ConfigurationDirectoryMode=0755
UMask=0027
LimitNOFILE=65536

# Hardening.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# Not ProcSubset=pid: NAT-PMP port mapping reads /proc/net/route.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# ReadOnlyPaths=/srv/tensorseed/publish
# ReadWritePaths=/srv/tensorseed/serve

[Install]
WantedBy=multi-user.target
