# Catalog host headers for catalog.tensorseed.dev (SPEC 6.8, 6.12).
# Cache-Control is set only on the paths that need it, so values are not joined.
# Spaces, not tabs. Exact paths plus directory prefixes.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS

/
/index.html
/404.html
/README.txt
  Cache-Control: public, max-age=300

/tensorseed/head.json
/tensorseed/head.json.minisig
/tensorseed/mirrors.toml
/tensorseed/mirrors.toml.minisig
/tensorseed/chain-proof.json
  Cache-Control: public, max-age=60, must-revalidate

/tensorseed/deltas/0000000001.json
/tensorseed/deltas/0000000001.json.minisig
/tensorseed/deltas/0000000002.json
/tensorseed/deltas/0000000002.json.minisig
/tensorseed/deltas/0000000003.json
/tensorseed/deltas/0000000003.json.minisig
/tensorseed/deltas/0000000004.json
/tensorseed/deltas/0000000004.json.minisig
/tensorseed/snapshots/0000000001.json
/tensorseed/snapshots/0000000001.json.minisig
  Cache-Control: public, max-age=31536000, immutable

# The content-name torrent path can be replaced when webseeds change.
/t/TunedChaos__ChaosNexus_Tuned_v1-GGUF@b43d53d2b975.torrent
  Content-Type: application/x-bittorrent
  Cache-Control: public, max-age=60, must-revalidate

/tensorseed/head.json.minisig
/tensorseed/mirrors.toml.minisig
/tensorseed/deltas/0000000001.json.minisig
/tensorseed/deltas/0000000002.json.minisig
/tensorseed/deltas/0000000003.json.minisig
/tensorseed/deltas/0000000004.json.minisig
/tensorseed/snapshots/0000000001.json.minisig
  Content-Type: application/minisign; charset=utf-8
