# Catalog host headers for catalog.tensorseed.dev (SPEC 6.8, 6.12).
# https://developers.cloudflare.com/pages/configuration/headers/
# Clients fetch heads, deltas, snapshots, signatures, and mirrors.toml over HTTP GET.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Cache-Control: public, max-age=300

# Head and published mirror list are rewritten each revision or publish.
/:catalog/head.json
/:catalog/head.json.minisig
/:catalog/mirrors.toml
/:catalog/mirrors.toml.minisig
  Cache-Control: public, max-age=60, must-revalidate

# Deltas and snapshots are append-only and never rewritten.
/:catalog/deltas/*
/:catalog/snapshots/*
  Cache-Control: public, max-age=31536000, immutable

# BitTorrent metainfo (webseeds live under /t/ per SPEC 6.12 and 7.1).
/*.torrent
/t/*.torrent
  Content-Type: application/x-bittorrent
  Cache-Control: public, max-age=31536000, immutable

# Detached minisign signatures for heads, deltas, snapshots, and mirror lists.
/*.minisig
/:catalog/*.minisig
/:catalog/deltas/*.minisig
/:catalog/snapshots/*.minisig
  Content-Type: application/minisign; charset=utf-8
