{
  "name": "tensorseed-site",
  "private": true,
  "type": "module",
  "description": "The tensorseed.dev website: SvelteKit, prerendered to static HTML.",
  "license": "AGPL-3.0-or-later",
  "author": "Tuned Chaos",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/assemble.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:links": "node scripts/check-links.mjs"
  },
  "engines": {
    "pnpm": ">=9"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tensorseed/ui": "link:../ui",
    "daisyui": "^5.8.0",
    "github-slugger": "^2.0.0",
    "marked": "^18.2.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.0",
    "vite": "^8.3.8"
  }
}
