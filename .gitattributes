# Normalize line endings: LF in the repo and in checkouts on every platform
# (rustfmt, shell scripts, and signed files all expect LF).
* text=auto eol=lf

*.rs       text eol=lf diff=rust
*.toml     text eol=lf
*.md       text eol=lf diff=markdown
*.sh       text eol=lf
*.py       text eol=lf diff=python
*.yml      text eol=lf
*.json     text eol=lf
*.html     text eol=lf diff=html
*.css      text eol=lf diff=css
*.svg      text eol=lf
justfile   text eol=lf
LICENSE    text eol=lf
_headers   text eol=lf

# Windows scripts need CRLF.
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Signed and binary content: never touch the bytes (a changed line ending
# would break a signature or an info hash).
*.torrent  binary
*.minisig  -text -diff
*.key      -text
*.pub      -text
/site/catalog/tensorseed/**  -text
/crates/tensorseed-catalog/tests/fixtures/**  -text
*.png      binary
*.jpg      binary
*.gif      binary
*.ico      binary
*.webp     binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.zip      binary
*.gz       binary
*.wasm     binary

# GitHub language stats and diffs: the published catalog tree is generated.
/site/catalog/tensorseed/**  linguist-generated=true
/site/catalog/t/**           linguist-generated=true
Cargo.lock                   linguist-generated=true

# Source archives (git archive): leave out development only paths.
/spikes/      export-ignore
/.github/     export-ignore
