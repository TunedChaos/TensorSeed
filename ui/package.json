{
  "name": "@tensorseed/ui",
  "version": "0.3.0-dev",
  "private": true,
  "type": "module",
  "description": "Svelte 5 components, types, and theme shared by the Tensorseed explorer and Tensorseed Desktop.",
  "license": "AGPL-3.0-or-later",
  "author": "Tuned Chaos",
  "exports": {
    "./components/*": {
