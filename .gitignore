/target/
**/*.rs.bk
*.pdb

# Local config and secrets (use config/tensorseed.example.toml as a template)
/tensorseed.toml
/config/tensorseed.toml
.env
.env.*

# Local state
*.sqlite
*.sqlite-journal

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Spike build output
/spikes/*/target/
/spikes/*/Cargo.lock

# Publisher secret keys and passphrases (never commit)
*.key
**/passphrase
