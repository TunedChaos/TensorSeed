#
# Desktop entry template for the deb (and rpm) bundles. %u passes a
# tensorseed:// link to the app, and the MimeType line makes it the
# handler for the scheme (xdg-open tensorseed://entry/org/name).
[Desktop Entry]
Type=Application
Name={{name}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %u
Icon={{icon}}
Terminal=false
Categories={{categories}}
MimeType=x-scheme-handler/tensorseed;
StartupWMClass={{exec}}
StartupNotify=true
