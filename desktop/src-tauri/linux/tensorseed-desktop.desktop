#
# Desktop entry template for the deb, rpm, and AppImage bundles. %u passes a
# tensorseed:// link to the app, and the MimeType line makes it the
# handler for the scheme (xdg-open tensorseed://entry/org/name).
[Desktop Entry]
Type=Application
Name={{name}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %u
Icon={{icon}}
Terminal=false
Categories=Network;FileTransfer;P2P;
MimeType=x-scheme-handler/tensorseed;
StartupWMClass={{exec}}
StartupNotify=true
