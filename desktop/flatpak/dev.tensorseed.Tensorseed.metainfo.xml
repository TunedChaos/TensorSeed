    <release version="0.3.1" date="2026-11-14">
      <url type="details">https://github.com/TunedChaos/TensorSeed/releases/tag/v0.3.1</url>
      <description>
        <p>Verified serving and catalog fixes in the shared library:</p>
        <ul>
          <li>Signed follow lists for catalogs</li>
          <li>Claim expiry and revocation</li>
