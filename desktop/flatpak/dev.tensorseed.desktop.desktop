#
# Desktop entry for the Flatpak. %u passes a tensorseed:// link to the app,
# and the MimeType line makes it the handler for the scheme.
[Desktop Entry]
Type=Application
Name=Tensorseed Desktop
GenericName=Model and Dataset Seeder
Comment=Download, seed, and serve AI models you can verify
Exec=tensorseed-desktop %u
Icon=dev.tensorseed.desktop
Terminal=false
Categories=Network;FileTransfer;P2P;
Keywords=tensorseed;huggingface;model;dataset;torrent;seed;
MimeType=x-scheme-handler/tensorseed;
StartupWMClass=tensorseed-desktop
StartupNotify=true
